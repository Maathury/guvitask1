# ----------------------------------------------------------------------------
# Maven Start Up Batch script
#
# Required ENV vars:
# ------------------
#   JAVA_HOME - location of a JDK home dir
#
# Optional ENV vars
# -----------------
#   MAVEN_OPTS - parameters passed to the Java VM when running Maven
#     e.g. to debug Maven itself, use
#       set MAVEN_OPTS=-Xdebug -Xrunjdwp:transport=dt_socket,server=y,suspend=y,address=8000
#   MAVEN_SKIP_RC - flag to disable loading of mavenrc files
# ----------------------------------------------------------------------------

if [ -z "$MAVEN_SKIP_RC" ] ; then

  if [ -f /etc/mavenrc ] ; then
    . /etc/mavenrc
  fi

  if [ -f "$HOME"/.mavenrc ] ; then
    . "$HOME"/.mavenrc
  fi

fi

# OS specific support.  $var _must_ be set to either true or false.
cygwin=false;
darwin=false;
mingw=false
case "`uname`" in
  CYGWIN*) cygwin=true ;;
  MINGW*) mingw=true ;;
  Darwin*) darwin=true ;;
  SunOS*) darwin=false ;;
  *) ;;

esac

# For Cygwin, ensure paths are in UNIX format before anything is touched.
if $cygwin ; then
  [ -n "$JAVA_HOME" ] && JAVA_HOME=`cygpath --unix "$JAVA_HOME"`
fi

# Locate the base directory
PRG="$0"
while [ -h "$PRG" ] ; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`"/$link"
  fi
done
SAVED="`pwd`"
cd "`dirname "$PRG"`/" >/dev/null
APP_BASE="`pwd -P`"
cd "$SAVED" >/dev/null

# Resolve .mvn directory
MVNW_DIR="$APP_BASE/.mvn"
WRAPPER_JAR="$MVNW_DIR/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MVNW_DIR/wrapper/maven-wrapper.properties"

# Download wrapper jar if missing
if [ ! -f "$WRAPPER_JAR" ]; then
  if [ -f "$WRAPPER_PROPERTIES" ]; then
    . "$WRAPPER_PROPERTIES" >/dev/null 2>&1 || true
  fi
  if [ -z "$wrapperUrl" ]; then
    wrapperUrl="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
  fi
  if command -v curl >/dev/null 2>&1; then
    mkdir -p "$MVNW_DIR/wrapper" && curl -fsSL "$wrapperUrl" -o "$WRAPPER_JAR"
  elif command -v wget >/dev/null 2>&1; then
    mkdir -p "$MVNW_DIR/wrapper" && wget -q "$wrapperUrl" -O "$WRAPPER_JAR"
  else
    echo "Error: Please install curl or wget to download the Maven Wrapper" >&2
    exit 1
  fi
fi

# Find Java
if [ -z "$JAVA_HOME" ] ; then
  JAVA_CMD="java"
else
  JAVA_CMD="$JAVA_HOME/bin/java"
fi

# Verify Java
"$JAVA_CMD" -version >/dev/null 2>&1 || {
  echo "Error: Java not found. Please install Java 17+ and ensure it is on PATH." >&2
  exit 1
}

# Determine project base dir
basedir=$(cd "$APP_BASE"; pwd)

# Execute Maven Wrapper
exec "$JAVA_CMD" $MAVEN_OPTS -classpath "$WRAPPER_JAR" -Dmaven.multiModuleProjectDirectory="$APP_BASE" org.apache.maven.wrapper.MavenWrapperMain "$@"